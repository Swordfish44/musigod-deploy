{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https://*.supabase.co https://*.n8n.cloud https://musigod-n8n.onrender.com https://cdn.jsdelivr.net https://api.stripe.com https://musigod.com https://api.discogs.com https://www.googleapis.com https://accounts.spotify.com https://api.spotify.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com;"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/dead",
            "destination": "/dead.html"
        },
        {
            "source": "/free-marketing-dead",
            "destination": "/free-marketing-dead.html"
        },
        {
            "source": "/favicon.ico",
            "destination": "/favicon.ico"
        },
        {
            "source": "/favicon-16.png",
            "destination": "/favicon-16.png"
        },
        {
            "source": "/favicon-32.png",
            "destination": "/favicon-32.png"
        },
        {
            "source": "/apple-touch-icon.png",
            "destination": "/apple-touch-icon.png"
        },
        {
            "source": "/favicon-192.png",
            "destination": "/favicon-192.png"
        },
        {
            "source": "/admin",
            "destination": "/admin.html"
        },
        {
            "source": "/portal",
            "destination": "/portal.html"
        },
        {
            "source": "/dashboard/registrations",
            "destination": "/dashboard-registrations.html"
        },
        {
            "source": "/dashboard/contracts",
            "destination": "/contract-intelligence.html"
        },
        {
            "source": "/dashboard/royalty-statements",
            "destination": "/royalty-statements.html"
        },
        {
            "source": "/admin/royalty-intelligence",
            "destination": "/admin-royalty-intelligence.html"
        },
        {
            "source": "/login",
            "destination": "/login.html"
        },
        {
            "source": "/earnings",
            "destination": "/earnings.html"
        },
        {
            "source": "/registration/:path*",
            "destination": "/registration-detail.html"
        },
        {
            "source": "/success",
            "destination": "/success.html"
        },
        {
            "source": "/rights-audit",
            "destination": "/rights-audit.html"
        },
        {
            "source": "/affiliates",
            "destination": "/affiliate-dashboard.html"
        },
        {
            "source": "/audit-status",
            "destination": "/audit-status.html"
        },
        {
            "source": "/catalog-intake",
            "destination": "/catalog-intake.html"
        },
        {
            "source": "/audit-admin",
            "destination": "/audit-admin.html"
        },
        {
            "source": "/catalog-enrichment",
            "destination": "/catalog-enrichment.html"
        },
        {
            "source": "/catalog-splits",
            "destination": "/catalog-splits.html"
        },
        {
            "source": "/recovery-tracker",
            "destination": "/recovery-tracker.html"
        },
        {
            "source": "/enterprise/harbourview",
            "destination": "/harbourview-pilot.html"
        },
        {
            "source": "/enterprise/harbourview/report",
            "destination": "/harbourview-rights-recovery-report.html"
        }
    ],
    "crons": [
        {
            "path": "/api/send-audit-drip",
            "schedule": "0 14 * * *"
        },
        {
            "path": "/api/admin/run-ingestion-worker",
            "schedule": "* * * * *"
        }
    ],
    "functions": {
        "api/run-enrichment-job.js": {
            "maxDuration": 300
        },
        "api/enrich-artist.js": {
            "maxDuration": 300
        },
        "api/save-writer-override.js": {
            "maxDuration": 10
        },
        "api/save-writer-splits.js": {
            "maxDuration": 10
        },
        "api/get-writer-splits.js": {
            "maxDuration": 10
        },
        "api/download-registration-csv.js": {
            "maxDuration": 30
        },
        "api/get-admin-queue.js": {
            "maxDuration": 10
        },
        "api/update-admin-queue-task.js": {
            "maxDuration": 10
        },
        "api/get-recovery-cases.js": {
            "maxDuration": 10
        },
        "api/rights-registration-center.js": {
            "maxDuration": 15
        },
        "api/contract-intelligence.js": {
            "maxDuration": 30
        },
        "api/statement-ingestion.js": {
            "maxDuration": 30
        },
        "api/admin/run-ingestion-worker.js": {
            "maxDuration": 300
        },
        "api/admin/run-synthetic-royalty-pilot.js": {
            "maxDuration": 30
        },
        "api/upload-registration-evidence.js": {
            "maxDuration": 30
        },
        "api/enterprise/harbourview-workspace.js": {
            "maxDuration": 15
        },
        "api/enterprise/import-batch.js": {
            "maxDuration": 30
        },
        "api/enterprise/portfolio-upload.js": {
            "maxDuration": 30
        },
        "api/enterprise/orchestrate-portfolio-analysis.js": {
            "maxDuration": 60
        }
    }
}
