# .env.local.example
#
# Template for local environment variables. Copy to .env.local (already
# gitignored via .env*.local) and fill in real values there — never commit
# actual credentials.
#
# This file currently documents only the SoundExchange integration. Other
# MusiGod env vars (Supabase, Stripe, Discogs, etc.) are managed in Vercel
# project settings — see CLAUDE.md.

# ── SoundExchange Repertoire Search API (lib/soundexchange-adapter.js) ──────
# Disabled (safe/no-op) until ALL FOUR of these are set. See
# docs/SOUNDEXCHANGE_API_ACCESS_REQUEST.md for how access is requested and
# what SoundExchange has confirmed. Do not guess values for these — they
# come from repertoire@soundexchange.com's approval response.

# Master switch. Must be the literal string "true" to activate the adapter.
SOUNDEXCHANGE_API_ENABLED=false

# Base URL for the Repertoire Search API, as issued by SoundExchange.
SOUNDEXCHANGE_API_BASE_URL=

# Search path/endpoint for recording/ISRC lookups, as documented by
# SoundExchange in their approval response.
SOUNDEXCHANGE_API_SEARCH_PATH=

# API key/token issued by SoundExchange. Never log, print, or commit this
# value — lib/soundexchange-adapter.js redacts it from every error/log line,
# but that only works if it's never hardcoded anywhere else.
SOUNDEXCHANGE_API_KEY=

# Optional tuning (sane defaults apply if unset):
SOUNDEXCHANGE_API_TIMEOUT_MS=8000
SOUNDEXCHANGE_API_MAX_RETRIES=2
SOUNDEXCHANGE_API_RATE_LIMIT_PER_MIN=30
